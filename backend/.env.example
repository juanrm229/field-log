# Copy to .env and adjust. This file is committed; .env is not.

# Local MongoDB. For MongoDB Atlas (free M0 tier) use the connection string
# it gives you: mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net
MONGO_URL=mongodb://localhost:27017
DB_NAME=juarnal_local

# Password for /studio (the owner-only CMS)
STUDIO_PASSWORD=koda3am

# Optional — only needed to email readers from Studio.
# Without it the app runs fine; the "kirim surat" feature stays disabled.
RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev
