# Copy to .env and adjust. This file is committed; .env is not.

# Local MongoDB. For MongoDB Atlas (free M0 tier) use the connection string it
# gives you: mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net
MONGO_URL=mongodb://localhost:27017
DB_NAME=juarnal_local

# Required — the app refuses to start without it. Unlocks /studio, the owner's
# CMS. Use something only you know; never reuse the value below in production.
STUDIO_PASSWORD=koda3am

# Comma-separated origins allowed to call this API. In production set it to your
# deployed frontend, e.g. https://field-log.vercel.app
CORS_ORIGINS=http://localhost:3000

# Optional — only needed to email readers from Studio. Without it the app runs
# fine and only that one feature is unavailable. Sending to anyone other than
# your own address requires a domain verified with Resend.
RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev
